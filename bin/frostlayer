#!/usr/bin/env bash
# FrostLayer: capa de estética Frost para Omarchy.
#   frostlayer install [módulo...]    aplica módulos (sin nombres: menú)
#   frostlayer uninstall [módulo...]  deshace módulos (sin nombres: todos)
#   frostlayer status | list | update
# Opciones: --yes (sin preguntas, módulos por defecto)  --dry-run (solo muestra)

set -euo pipefail

FL_ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
FL_VERSION=$(cat "$FL_ROOT/VERSION" 2>/dev/null || echo dev)
# shellcheck source=../lib/common.sh
source "$FL_ROOT/lib/common.sh"

ASSUME_YES=0

banner() {
  printf '\n%s  ❄  F R O S T L A Y E R%s  %sv%s%s\n\n' "$FL_C_ICE" "$FL_C_RESET" "$FL_C_DIM" "$FL_VERSION" "$FL_C_RESET"
}

modules_all() {
  local dir
  for dir in "$FL_ROOT"/modules/*/; do
    [[ -f $dir/module.sh ]] && basename "$dir"
  done
}

# Carga un módulo en una subshell para que sus funciones no se mezclen.
with_module() {
  local name=$1 action=$2
  local MODULE_DIR="$FL_ROOT/modules/$name"
  [[ -f $MODULE_DIR/module.sh ]] || { fl_err "No existe el módulo «$name»"; return 1; }
  (
    MODULE_DESC="" MODULE_DEFAULT=0
    # shellcheck source=/dev/null
    source "$MODULE_DIR/module.sh"
    case $action in
      desc) printf '%s' "$MODULE_DESC" ;;
      default) [[ $MODULE_DEFAULT == 1 ]] ;;
      check) module_check ;;
      apply) module_apply ;;
      revert) module_revert ;;
    esac
  )
}

choose_modules() {
  local names=() labels=() defaults=() name
  while read -r name; do
    names+=("$name")
    labels+=("$name · $(with_module "$name" desc)")
    with_module "$name" default && defaults+=("$name · $(with_module "$name" desc)")
  done < <(modules_all)

  if [[ $ASSUME_YES == 1 ]] || ! command -v gum >/dev/null || ! [[ -t 0 ]]; then
    printf '%s\n' "${defaults[@]%% · *}"
    return
  fi
  local selected
  selected=$(IFS=,; gum choose --no-limit --header "¿Qué quieres aplicar? (espacio para marcar, Enter para seguir)" \
    --selected "${defaults[*]}" "${labels[@]}") || return 1
  printf '%s\n' "$selected" | sed 's/ · .*//'
}

cmd_install() {
  banner
  local modules=("$@")
  if ((${#modules[@]} == 0)); then
    mapfile -t modules < <(choose_modules)
  fi
  ((${#modules[@]})) || { fl_warn "No has elegido ningún módulo."; return 0; }

  local name reason failed=0
  for name in "${modules[@]}"; do
    fl_info "$name · $(with_module "$name" desc)"
    if ! reason=$(with_module "$name" check 2>&1); then
      fl_warn "  Saltado: $reason"
      failed=1
      continue
    fi
    if with_module "$name" apply; then
      fl_mark_installed "$name"
      fl_ok "  Listo"
    else
      fl_err "  Ha fallado «$name»"
      failed=1
    fi
  done
  echo
  fl_dim "Deshacer: frostlayer uninstall [módulo]   ·   Copias: $FL_STATE/backups"
  return $failed
}

cmd_uninstall() {
  banner
  local modules=("$@") name
  if ((${#modules[@]} == 0)); then
    while read -r name; do fl_is_installed "$name" && modules+=("$name"); done < <(modules_all)
  fi
  ((${#modules[@]})) || { fl_info "No hay módulos de FrostLayer instalados."; return 0; }
  for name in "${modules[@]}"; do
    fl_info "Deshaciendo $name"
    if with_module "$name" revert; then
      fl_unmark_installed "$name"
      fl_ok "  Deshecho"
    else
      fl_err "  No se pudo deshacer «$name» del todo"
    fi
  done
}

cmd_status() {
  banner
  local name mark
  while read -r name; do
    if fl_is_installed "$name"; then
      mark="${FL_C_OK}● instalado $(cat "$FL_STATE/installed/$name")${FL_C_RESET}"
    else
      mark="${FL_C_DIM}○ no instalado${FL_C_RESET}"
    fi
    printf '  %-10s %s\n' "$name" "$mark"
  done < <(modules_all)
}

cmd_list() {
  local name tag
  while read -r name; do
    tag=$(with_module "$name" default && echo "por defecto" || echo "opcional")
    printf '%-10s %-12s %s\n' "$name" "$tag" "$(with_module "$name" desc)"
  done < <(modules_all)
}

cmd_update() {
  banner
  if [[ -d $FL_ROOT/.git ]]; then
    fl_info "Actualizando FrostLayer"
    git -C "$FL_ROOT" pull --ff-only
  fi
  local installed=() name
  while read -r name; do fl_is_installed "$name" && installed+=("$name"); done < <(modules_all)
  ((${#installed[@]})) && exec "$FL_ROOT/bin/frostlayer" install "${installed[@]}"
}

main() {
  local args=() arg
  for arg in "$@"; do
    case $arg in
      --yes | -y) ASSUME_YES=1 ;;
      --dry-run) FL_DRY_RUN=1 ;;
      -h | --help) sed -n '2,6p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; return 0 ;;
      *) args+=("$arg") ;;
    esac
  done
  set -- "${args[@]+"${args[@]}"}"
  local cmd=${1:-install}
  shift || true
  case $cmd in
    install) cmd_install "$@" ;;
    uninstall | remove) cmd_uninstall "$@" ;;
    status) cmd_status ;;
    list) cmd_list ;;
    update) cmd_update ;;
    *) fl_err "Comando desconocido: $cmd"; return 1 ;;
  esac
}

main "$@"
